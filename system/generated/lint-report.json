  "codeRules": [
    {
      "id": "code.no-raw-elements",
      "level": "core",
      "scope": "все продукты",
      "file": "system/core/code-rules.json",
      "kind": "no-raw-elements",
      "title": "Без голых элементов, если есть компонент",
      "why": "Голая кнопка или таблица выглядит почти как системная, но не обновляется вместе с системой и не соблюдает её правила.",
      "addedBy": "владелец системы",
      "since": "2026-10-24",
      "message": "Голый элемент вместо компонента системы"
    },
    {
      "id": "code.no-inline-style",
      "level": "core",
      "scope": "все продукты",
      "file": "system/core/code-rules.json",
      "kind": "no-inline-style",
      "title": "Без инлайн-стилей",
      "why": "Инлайн-стиль не видят ни токены, ни бренд, ни проверка — это вид в обход системы.",
      "addedBy": "владелец системы",
      "since": "2026-10-24",
      "message": "Инлайн-стиль в коде продукта"
    },
    {
      "id": "code.css-tokens",
      "level": "core",
      "scope": "все продукты",
      "file": "system/core/code-rules.json",
      "kind": "css-tokens",
      "title": "В стилях продукта — только существующие токены",
      "why": "Цвет числом не перекрасится вместе с брендом и темой. Выдуманный токен молча не сработает.",
      "addedBy": "владелец системы",
      "since": "2026-10-24",
      "message": "Стиль мимо токенов"
    },
    {
      "id": "code.screen-size",
      "level": "core",
      "scope": "все продукты",
      "file": "system/core/code-rules.json",
      "kind": "max-lines",
      "title": "Экран — не длиннее 250 строк",
      "why": "Длинный экран — признак, что раскладка не по шаблону или данные лежат внутри экрана. Его трудно читать и человеку, и агенту.",
      "addedBy": "владелец системы",
      "since": "2026-10-24",
      "message": "Файл экрана слишком длинный — разделите или вынесите данные"
    },
    {
      "id": "code.screens-registered",
      "level": "core",
      "scope": "все продукты",
      "file": "system/core/code-rules.json",
      "kind": "screen-registry",
      "title": "Экран — в product.json и в маршрутах",
      "why": "Экран без строки в product.json не видят снимок, витрина и журнал продукта. Строка без файла или без маршрута — экран, которого нет.",
      "addedBy": "владелец системы",
      "since": "2026-10-24",
      "message": "Экраны, product.json и маршруты разошлись"
    },
    {
      "id": "merrow.glossary",
      "level": "brand",
      "scope": "продукты бренда merrow",
      "file": "system/brands/merrow/rules.json",
      "kind": "glossary",
      "title": "Слова — из словаря бренда",
      "why": "Одно понятие — одно слово во всех продуктах бренда. Колонка «не пишем» из словаря становится проверкой.",
      "addedBy": "автор текстов Merrow",
      "since": "2026-10-24",
      "message": "Слово не из словаря бренда"
    },
    {
      "id": "admin.currency-eur",
      "level": "product",
      "scope": "Merrow Admin",
      "file": "apps/crm/rules.json",
      "kind": "forbidden-text",
      "title": "Цены — только в евро",
      "why": "Магазины Merrow Admin продают в еврозоне. Цена в долларах или фунтах в интерфейсе — ошибка данных или копипаста.",
      "addedBy": "команда Merrow Admin",
      "since": "2026-10-24",
      "message": "Цена не в евро"
    }
  ],
